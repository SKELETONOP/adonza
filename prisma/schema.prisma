// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id @map("_id")
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// triggerMode:   "specific"  - only the products listed in triggerItems count
//                "storewide" - any product in the cart counts
// triggerBasis:  "quantity"  - condition is a unit count (uses triggerQuantity)
//                "amount"    - condition is a cart subtotal (uses triggerAmount, in cents)
model Rule {
  id              String   @id @default(cuid()) @map("_id")
  shop            String
  title           String
  active          Boolean  @default(true)

  triggerMode     String   @default("specific")
  triggerBasis    String   @default("quantity")
  triggerQuantity Int      @default(1)
  triggerAmount   Int?
  freeQuantity    Int      @default(1)

  // Embedded documents (not a separate collection) - MongoDB's natural fit
  // for data that's always read/written together with its parent Rule.
  triggerItems    RuleTriggerItem[]
  freeOptions     RuleFreeOption[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([shop])
  @@index([shop, active])
}

// One eligible trigger product/variant for a "specific" rule. Embedded on
// the Rule document - ignored (and normally empty) when triggerMode is
// "storewide".
type RuleTriggerItem {
  productId    String
  productTitle String
  variantId    String
  variantTitle String
  imageUrl     String?
}

// One product/variant the shopper can choose as their free gift once the
// rule's condition is met. A rule can offer several options; the shopper
// picks exactly one via the storefront popup. Embedded on the Rule document.
type RuleFreeOption {
  productId    String
  productTitle String
  variantId    String
  variantTitle String
  imageUrl     String?
}

// Per-shop appearance settings for the storefront free-gift popup, plus the
// id of this shop's automatic discount (see app/models/discount.server.js)
// that makes auto-added free-gift lines 100% off without ever touching the
// product's real catalog price.
model ShopSettings {
  id                  String   @id @default(cuid()) @map("_id")
  shop                String   @unique
  popupHeading        String   @default("You've unlocked a free gift!")
  popupSubheading     String   @default("Choose which one you'd like:")
  imageShape          String   @default("rounded") // "rounded" | "square"
  titleColor          String   @default("#1a1a1a")
  buttonColor         String   @default("#008060")
  buttonTextColor     String   @default("#ffffff")
  automaticDiscountId String?
  updatedAt           DateTime @updatedAt
}

model Feedback {
  id        String   @id @default(cuid()) @map("_id")
  shop      String
  message   String
  createdAt DateTime @default(now())

  @@index([shop])
}
